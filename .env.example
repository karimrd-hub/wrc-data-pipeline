# WRC pipeline configuration.
# Copy to `.env` and edit only what you need — every value has a sensible default.
# Real shell env vars override values in this file.

# ---- MongoDB ----------------------------------------------------------------
# Connection string + logical layout. Timeouts are safety nets against a wedged
# server (without them the driver silently stalls per operation).
MONGO_URI=mongodb://localhost:27017
MONGO_DB=wrc
MONGO_LANDING_COLLECTION=landing_metadata
MONGO_PROCESSED_COLLECTION=processed_metadata
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=30000

# ---- MinIO (S3-compatible object storage) -----------------------------------
# Endpoint + credentials + bucket names. Timeouts are safety nets against a
# half-open connection; defaults are generous enough for large PDFs on slow uplinks.
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
MINIO_LANDING_BUCKET=landing-zone
MINIO_PROCESSED_BUCKET=processed
MINIO_CONNECT_TIMEOUT_SEC=5.0
MINIO_READ_TIMEOUT_SEC=30.0

# ---- docker-compose port bindings (host side) -------------------------------
# Change these if your host already uses 27017 / 9000 / 9001.
MONGO_HOST_PORT=27017
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Scraper throttling -----------------------------------------------------
# Per-process AutoThrottle target = 4.0. Combined with
# DAGSTER_MAX_CONCURRENT_RUNS=4 below, aggregate WRC-domain load stays
# near ~16 concurrent — the posture our internal load testing found to
# be reliably sustainable on multi-hour crawls. More aggressive
# configurations (aggregate ~80+) were measurably faster on single-run
# benchmarks but drew server-side blocking on sustained runs, so we
# ship the conservative posture as the default.
#
# CONCURRENT_REQUESTS(_PER_DOMAIN) is the hard ceiling AutoThrottle can
# grow into. At 8 it sits 2× above the target — enough headroom for
# transient bursts, tight enough that AutoThrottle can never climb back
# into the range that historically caused blocking.
SCRAPER_CONCURRENT_REQUESTS=8
SCRAPER_CONCURRENT_REQUESTS_PER_DOMAIN=8
SCRAPER_DOWNLOAD_DELAY=0.0
SCRAPER_AUTOTHROTTLE_ENABLED=true
SCRAPER_AUTOTHROTTLE_START_DELAY=0.25
SCRAPER_AUTOTHROTTLE_MAX_DELAY=10.0
SCRAPER_AUTOTHROTTLE_TARGET_CONCURRENCY=4.0
SCRAPER_RETRY_TIMES=5

# Anti-fingerprint hygiene: rotate the outgoing User-Agent so requests
# don't share a single static fingerprint that a WAF can flag. Default
# pool of six realistic desktop-browser UAs lives in config/settings.py.
# Override with a pipe-separated list — pipes chosen because real UA
# strings contain commas, semicolons and parentheses but never pipes.
# Uncomment to override:
# SCRAPER_USER_AGENT_POOL=Mozilla/5.0 (Windows NT 10.0; ... Chrome/130 ...|Mozilla/5.0 (Macintosh; ... Safari ...)

# Partition granularity used by the spider for tagging `partition_date`.
# One of: monthly | weekly | daily. Default monthly matches the Dagster asset's
# MonthlyPartitionsDefinition — keeping them aligned means one Dagster
# partition == one row in Mongo's `partition_date` axis.
SCRAPER_PARTITION_SIZE=monthly

# Bodies to scrape — comma-separated `id:Name` pairs. The name is the
# human-readable label that ends up in Mongo's `body` field and in log events;
# the numeric id is what the WRC search URL expects. Drop entries you don't
# want to scrape; add new ones as the site exposes them.
SCRAPER_BODIES=1:Equality Tribunal,2:Employment Appeals Tribunal,3:Labour Court,15376:Workplace Relations Commission

# Root log level for the JSON-formatted logger.
SCRAPER_LOG_LEVEL=INFO

# ---- Transform --------------------------------------------------------------
# Batched Mongo writes: flush pending UpdateOne ops when this many are queued.
# Higher = fewer round-trips, more peak memory during a run.
TRANSFORM_BULK_BATCH_SIZE=200

# ---- Dagster ---------------------------------------------------------------
# Web UI port + earliest partition offered in Dagit's MonthlyPartitionsDefinition.
DAGSTER_PORT=3000
DAGSTER_PARTITION_START_DATE=2010-01-01

# How many Dagster partition runs execute concurrently. Each run is a
# separate Scrapy subprocess with its own AutoThrottle target, so
# aggregate WRC-domain load = N × per-process target. At target=4.0,
# N=4 gives aggregate ≈ 16 — the safe posture our internal load
# testing settled on. Higher values (up to aggregate ~84) were
# measurably faster on isolated benchmark runs but drew server-side
# blocking on sustained crawls; we prioritise reliability over peak
# throughput. Pull back further to 2 (aggregate ~8) if the target site
# tightens throttling.
DAGSTER_MAX_CONCURRENT_RUNS=4

# Wall-clock ceiling on the Scrapy subprocess spawned by landing_records.
# Safety net against a wedged spider — one hour is well beyond any observed
# partition runtime; bump only if a real workload trips it.
DAGSTER_SUBPROCESS_TIMEOUT_SEC=3600

# Per-asset retry policy (attempts after the first failure + wait between).
DAGSTER_LANDING_MAX_RETRIES=2
DAGSTER_LANDING_RETRY_DELAY_SEC=30
DAGSTER_PROCESSED_MAX_RETRIES=2
DAGSTER_PROCESSED_RETRY_DELAY_SEC=15
