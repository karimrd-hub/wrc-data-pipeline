# WRC pipeline configuration.
# Copy to `.env` and edit only what you need — every value has a sensible default.
# Real shell env vars override values in this file.

# ---- MongoDB ----------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=wrc
MONGO_LANDING_COLLECTION=landing_metadata
MONGO_PROCESSED_COLLECTION=processed_metadata

# ---- MinIO (S3-compatible object storage) -----------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
MINIO_LANDING_BUCKET=landing-zone
MINIO_PROCESSED_BUCKET=processed

# ---- docker-compose port bindings (host side) -------------------------------
# Change these if your host already uses 27017 / 9000 / 9001.
MONGO_HOST_PORT=27017
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Scraper throttling -----------------------------------------------------
# Validated on WRC body Jun 2025 probe: 213 requests / 58s, zero 4xx/5xx, zero retries.
# AutoThrottle stays on as the safety belt — if the site pushes back, it backs off.
SCRAPER_CONCURRENT_REQUESTS=32
SCRAPER_CONCURRENT_REQUESTS_PER_DOMAIN=16
SCRAPER_DOWNLOAD_DELAY=0.0
SCRAPER_AUTOTHROTTLE_ENABLED=true
SCRAPER_AUTOTHROTTLE_TARGET_CONCURRENCY=4.0
SCRAPER_RETRY_TIMES=3

# Partition granularity used by the spider and by the Dagster asset for
# tagging `partition_date`. One of: monthly | weekly | daily. Default monthly
# matches the Dagster asset's own partitioning.
SCRAPER_PARTITION_SIZE=monthly

# Root log level for the JSON-formatted logger.
SCRAPER_LOG_LEVEL=INFO

# ---- Dagster ---------------------------------------------------------------
DAGSTER_PORT=3000
