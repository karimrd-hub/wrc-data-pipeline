# WRC pipeline configuration.
# Copy to `.env` and edit only what you need — every value has a sensible default.
# Real shell env vars override values in this file.

# ---- MongoDB ----------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=wrc
MONGO_LANDING_COLLECTION=landing_metadata
MONGO_PROCESSED_COLLECTION=processed_metadata

# ---- MinIO (S3-compatible object storage) -----------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
MINIO_LANDING_BUCKET=landing-zone
MINIO_PROCESSED_BUCKET=processed

# ---- docker-compose port bindings (host side) -------------------------------
# Change these if your host already uses 27017 / 9000 / 9001.
MONGO_HOST_PORT=27017
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Scraper throttling -----------------------------------------------------
# Per-process AutoThrottle target = 8.0 (our validated aggressive number, see
# docs/performance-baseline.md). Combined with DAGSTER_MAX_CONCURRENT_RUNS=2
# below, aggregate WRC-domain load stays at ~16 concurrent — same as the
# reference-repo baseline but with fewer, faster partitions.
SCRAPER_CONCURRENT_REQUESTS=16
SCRAPER_CONCURRENT_REQUESTS_PER_DOMAIN=16
SCRAPER_DOWNLOAD_DELAY=0.0
SCRAPER_AUTOTHROTTLE_ENABLED=true
SCRAPER_AUTOTHROTTLE_START_DELAY=0.25
SCRAPER_AUTOTHROTTLE_MAX_DELAY=10.0
SCRAPER_AUTOTHROTTLE_TARGET_CONCURRENCY=8.0
SCRAPER_RETRY_TIMES=5

# Partition granularity used by the spider for tagging `partition_date`.
# One of: monthly | weekly | daily. Default monthly matches the Dagster asset's
# MonthlyPartitionsDefinition — keeping them aligned means one Dagster
# partition == one row in Mongo's `partition_date` axis.
SCRAPER_PARTITION_SIZE=monthly

# Bodies to scrape — comma-separated `id:Name` pairs. The name is the
# human-readable label that ends up in Mongo's `body` field and in log events;
# the numeric id is what the WRC search URL expects. Drop entries you don't
# want to scrape; add new ones as the site exposes them.
SCRAPER_BODIES=1:Equality Tribunal,2:Employment Appeals Tribunal,3:Labour Court,15376:Workplace Relations Commission

# Root log level for the JSON-formatted logger.
SCRAPER_LOG_LEVEL=INFO

# ---- Dagster ---------------------------------------------------------------
DAGSTER_PORT=3000

# Earliest partition offered in Dagit's MonthlyPartitionsDefinition. Runs
# before this date are not backfillable without a code change.
DAGSTER_PARTITION_START_DATE=2020-01-01

# How many Dagster partition runs execute concurrently. Each run is a
# separate Scrapy subprocess with its own AutoThrottle target, so aggregate
# WRC-domain load = N × per-process concurrency. At target=8.0, N=2 keeps
# aggregate at 16 — the reference-repo baseline. Pull back to 1 if you see
# 429s or repeated 5xx.
DAGSTER_MAX_CONCURRENT_RUNS=2
